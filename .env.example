# 서버 ~/app/.env 에 값 채워서 사용 (커밋 금지)
MYSQL_ROOT_PASSWORD=
DB_NAME=gyejol_danji
DB_PORT=3306
DB_USERNAME=sagye
DB_PASSWORD=
DB_URL=jdbc:mysql://localhost:3306/gyejol_danji?serverTimezone=UTC&characterEncoding=UTF-8

GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=contents!A2:Q
GOOGLE_SHEETS_SYNC_CRON=0 */5 * * * *
GOOGLE_SHEETS_SYNC_ZONE=Asia/Seoul
GOOGLE_SHEETS_PROCESSING_TIMEOUT_MINUTES=10
GOOGLE_SHEETS_RECOMMENDATION_RANGE=weekly_recommendations!A2:E
GOOGLE_SHEETS_RECOMMENDATION_GENERATION_CRON=0 0 0 * * MON
GOOGLE_SHEETS_RECOMMENDATION_SYNC_CRON=0 */5 * * * *
GOOGLE_SHEETS_RECOMMENDATION_ZONE=Asia/Seoul
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# docker-compose.yml이 ./secrets/jwt, ./secrets/toss를 컨테이너의 /run/secrets/jwt, /run/secrets/toss로 마운트한다.
AUTH_JWT_PRIVATE_KEY_PATH=/run/secrets/jwt/jwt-private.pem
AUTH_JWT_PUBLIC_KEY_PATH=/run/secrets/jwt/jwt-public.pem
TOSS_MTLS_KEYSTORE_PATH=/run/secrets/toss/toss-mtls.p12
